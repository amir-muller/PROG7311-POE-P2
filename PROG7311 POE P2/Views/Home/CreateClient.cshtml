@model Web_API.Models.Client.Client

@{
	ViewData["Title"] = "Add New Client";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Create New Client</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateClient" method="post">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Client Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. John Doe" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="contactDetails" class="form-label">Contact Details</label>
                            <input asp-for="contactDetails" class="form-control" placeholder="Email or Phone" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Region" class="form-label">Region</label>
                            <select asp-for="Region" class="form-select">
                                <option value="">-- Select Region --</option>
                                <option value="South Africa">South Africa</option>
                                <option value="Namibia">Namibia</option>                   
                            </select>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                            <button type="submit" class="btn btn-success">Save Client</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
