@model PROG7311_POE_P2.Models.Contract.Contract

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-file-earmark-x"></i> Delete Contract Confirmation</h4>
                </div>
                <div class="card-body text-center">
                    <p class="lead text-danger"><strong>Warning:</strong> You are about to delete this contract record.</p>
                    <hr />
                    <dl class="row text-start">
                        <dt class="col-sm-5">Contract ID:</dt>
                        <dd class="col-sm-7">#@Model.ContractId</dd>

                        <dt class="col-sm-5">Client ID Reference:</dt>
                        <dd class="col-sm-7">@Model.ClientId</dd>

                        <dt class="col-sm-5">Start Date:</dt>
                        <dd class="col-sm-7">@Model.StartDate.ToShortDateString()</dd>

                        <dt class="col-sm-5">Service Level:</dt>
                        <dd class="col-sm-7">@Model.ServiceLevel</dd>
                    </dl>

                    <form asp-action="DeleteContract" method="post">
                        <input type="hidden" asp-for="ContractId" name="id" />
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger">Confirm Deletion</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>