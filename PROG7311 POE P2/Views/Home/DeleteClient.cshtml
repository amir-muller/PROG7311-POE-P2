@model PROG7311_POE_P2.Models.Client.Client

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Deletion</h4>
                </div>
                <div class="card-body text-center">
                    <p class="lead">Are you sure you want to delete this client?</p>
                    <hr />
                    <dl class="row text-start">
                        <dt class="col-sm-4">Client Name:</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Region:</dt>
                        <dd class="col-sm-8">@Model.Region</dd>
                    </dl>

                    <form asp-action="DeleteClient" method="post">
                        <input type="hidden" asp-for="ClientId" name="id" />
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger">Permanently Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>