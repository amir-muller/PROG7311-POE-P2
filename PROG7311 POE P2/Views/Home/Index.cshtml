@model dynamic
@* look at the use use of viewbags *@

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5"><i class="bi bi-speedometer2"></i> Management Dashboard</h1>
            <p class="text-muted">Overview of current clients, active contracts, and pending service requests.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-light border-0 shadow-sm">
                <div class="card-body d-flex gap-3">
                    <a class="btn btn-success" asp-controller="Home" asp-action="CreateClient">
                        <i class="bi bi-person-plus"></i> New Client
                    </a>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="CreateContract">
                        <i class="bi bi-file-earmark-plus"></i> New Contract
                    </a>
                    <a class="btn btn-warning" asp-controller="Home" asp-action="CreateServiceRequest">
                        <i class="bi bi-tools"></i> New Service Request
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Registered Clients</h5>
                    <span class="badge bg-secondary">@((Model.Clients as IEnumerable<PROG7311_POE_P2.Models.Client.Client>)?.Count() ?? 0) Total</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 400px;">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Region</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var client in Model.Clients)
                                {
                                    <tr>
                                        <td><strong>@client.Name</strong></td>
                                        <td><span class="badge bg-info text-dark">@client.Region</span></td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@client.ClientId">Edit</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Active Contracts</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 400px;">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Client ID</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var contract in Model.Contracts)
                                {
                                    <tr>
                                        <td>#@contract.ClientId</td>
                                        <td>@contract.StartDate.ToShortDateString()</td>
                                        <td>@contract.EndDate.ToShortDateString()</td>
                                        <td>
                                            @if (contract.EndDate < DateOnly.FromDateTime(DateTime.Now))
                                            {
                                                <span class="text-danger fw-bold">Expired</span>
                                            }
                                            else
                                            {
                                                <span class="text-success fw-bold">Active</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Recent Service Requests</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Description</th>
                                    <th>Cost</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model.ServiceRequests)
                                {
                                    <tr>
                                        <td>#@request.ServiceRequestId</td>
                                        <td>@request.Description</td>
                                        <td>@request.Cost.ToString("R")</td>
                                        <td>
                                            <span class="badge @(request.Status == "Pending" ? "bg-warning" : "bg-success")">
                                                @request.Status
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-dark">Update</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>