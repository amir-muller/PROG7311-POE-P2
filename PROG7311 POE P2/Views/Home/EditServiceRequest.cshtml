@model Web_API.Models.ServiceRequest.ServiceRequest

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">Edit Service Request</h4>
                </div>
                <div class="card-body">
                    <form asp-action="EditServiceRequest" method="post">
                        <input type="hidden" asp-for="ServiceRequestId" />
                        <input type="hidden" asp-for="ContractId" />

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cost" class="form-label">Cost (R)</label>
                            <input asp-for="Cost" class="form-control" type="number" step="0.01" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-dark">Update Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>